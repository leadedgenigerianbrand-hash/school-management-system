    <script>
        "use strict";

        const API_BASE = "/api";

        let staffId = null;
        let currentStaff = null;
        let editModalInstance = null;

        function getStaffId() {
            const params = new URLSearchParams(window.location.search);

            return (
                params.get("id") ||
                params.get("staffId")
            );
        }

        function getToken() {
            return (
                localStorage.getItem("school_management_token") ||
                sessionStorage.getItem("school_management_token") ||
                localStorage.getItem("token") ||
                localStorage.getItem("accessToken") ||
                sessionStorage.getItem("token") ||
                sessionStorage.getItem("accessToken")
            );
        }

        function authHeaders() {
            const token = getToken();

            const headers = {
                "Content-Type": "application/json"
            };

            if (token) {
                headers.Authorization = `Bearer ${token}`;
            }

            return headers;
        }

        function getField(object, ...names) {
            if (!object) {
                return "";
            }

            for (const name of names) {
                if (
                    object[name] !== undefined &&
                    object[name] !== null
                ) {
                    return object[name];
                }
            }

            return "";
        }

        function displayValue(value) {
            if (
                value === null ||
                value === undefined ||
                String(value).trim() === ""
            ) {
                return "—";
            }

            return value;
        }

        function formatDate(value) {
            if (!value) {
                return "—";
            }

            const date = new Date(value);

            if (Number.isNaN(date.getTime())) {
                return displayValue(value);
            }

            return date.toLocaleDateString("en-NG", {
                year: "numeric",
                month: "long",
                day: "numeric"
            });
        }

        function formatDateInput(value) {
            if (!value) {
                return "";
            }

            return String(value).substring(0, 10);
        }

        function getName(staff) {
            const firstName = getField(
                staff,
                "first_name",
                "firstName"
            );

            const middleName = getField(
                staff,
                "middle_name",
                "middleName"
            );

            const lastName = getField(
                staff,
                "last_name",
                "lastName"
            );

            return [
                firstName,
                middleName,
                lastName
            ]
                .filter(Boolean)
                .join(" ")
                .trim();
        }

        function getInitials(name) {
            if (!name) {
                return "ST";
            }

            const parts = name
                .trim()
                .split(/\s+/)
                .filter(Boolean);

            if (parts.length === 1) {
                return parts[0]
                    .substring(0, 2)
                    .toUpperCase();
            }

            return (
                parts[0][0] +
                parts[parts.length - 1][0]
            ).toUpperCase();
        }

        function formatStatus(status) {
            if (!status) {
                return "Unknown";
            }

            return String(status)
                .replace(/_/g, " ")
                .replace(/\b\w/g, letter => letter.toUpperCase());
        }

        function getStatusClass(status) {
            const normalized = String(status || "")
                .toLowerCase()
                .replace(/\s+/g, "_");

            if (normalized === "inactive") {
                return "status-inactive";
            }

            if (
                normalized === "on_leave" ||
                normalized === "onleave"
            ) {
                return "status-on_leave";
            }

            return "status-active";
        }

        function setText(id, value) {
            const element = document.getElementById(id);

            if (!element) {
                return;
            }

            const finalValue = displayValue(value);

            element.textContent = finalValue;

            element.classList.toggle(
                "empty-value",
                finalValue === "—"
            );
        }

        function showError(message) {
            const element = document.getElementById("errorMessage");

            if (!element) {
                return;
            }

            element.querySelector("span").textContent =
                message || "An error occurred.";

            element.classList.remove("d-none");
        }

        function hideError() {
            const element = document.getElementById("errorMessage");

            if (element) {
                element.classList.add("d-none");
            }
        }

        function showEditError(message) {
            const element = document.getElementById("editError");

            if (!element) {
                return;
            }

            element.textContent =
                message || "Unable to save staff information.";

            element.classList.remove("d-none");
        }

        function hideEditError() {
            const element = document.getElementById("editError");

            if (element) {
                element.classList.add("d-none");
            }
        }

        function showToast(message, type = "success") {
            const toastElement = document.getElementById("toast");

            if (!toastElement) {
                return;
            }

            toastElement.classList.remove(
                "text-bg-success",
                "text-bg-danger"
            );

            toastElement.classList.add(
                type === "error"
                    ? "text-bg-danger"
                    : "text-bg-success"
            );

            toastElement.querySelector(".toast-body").textContent =
                message;

            const toast =
                bootstrap.Toast.getOrCreateInstance(
                    toastElement,
                    {
                        delay: 3500
                    }
                );

            toast.show();
        }

        function getResponseData(result) {
            if (!result) {
                return null;
            }

            if (result.data !== undefined) {
                return result.data;
            }

            if (result.staff !== undefined) {
                return result.staff;
            }

            return result;
        }

        function renderPhoto(staff, fullName) {
            const photo = getField(
                staff,
                "photo_url",
                "photoUrl",
                "profile_photo",
                "profilePhoto",
                "photo"
            );

            const photoContainer =
                document.getElementById("profilePhoto");

            if (!photoContainer) {
                return;
            }

            if (!photo) {
                photoContainer.innerHTML =
                    `<span id="initials">${getInitials(fullName)}</span>`;

                return;
            }

            const safePhoto = String(photo)
                .replace(/"/g, "&quot;");

            const safeName = String(fullName)
                .replace(/"/g, "&quot;");

            photoContainer.innerHTML =
                `<img src="${safePhoto}" alt="${safeName}">`;
        }

        function renderStatus(status) {
            const finalStatus = status || "active";

            const badge =
                document.getElementById("statusBadge");

            const activateButton =
                document.getElementById("activateButton");

            const deactivateButton =
                document.getElementById("deactivateButton");

            const normalizedStatus =
                String(finalStatus)
                    .toLowerCase()
                    .replace(/\s+/g, "_");

            badge.className =
                `status-badge ${getStatusClass(finalStatus)}`;

            badge.innerHTML =
                normalizedStatus === "active"
                    ? `<i class="bi bi-check-circle-fill"></i> Active`
                    : `<i class="bi bi-info-circle-fill"></i> ${formatStatus(finalStatus)}`;

            activateButton.style.display =
                normalizedStatus === "active"
                    ? "none"
                    : "inline-block";

            deactivateButton.style.display =
                normalizedStatus === "inactive"
                    ? "none"
                    : "inline-block";
        }

        function renderProfile(staff) {
            currentStaff = staff;

            const fullName =
                getName(staff) || "Staff Member";

            const staffNumber =
                getField(
                    staff,
                    "staff_number",
                    "staffNumber"
                );

            const position =
                getField(
                    staff,
                    "position"
                );

            const department =
                getField(
                    staff,
                    "department_name",
                    "departmentName",
                    "department"
                );

            const status =
                getField(
                    staff,
                    "status"
                ) || "active";

            setText("staffName", fullName);

            setText(
                "staffNumber",
                staffNumber
                    ? `Staff Number: ${staffNumber}`
                    : "Staff Number: —"
            );

            setText(
                "staffPosition",
                position
                    ? `Position: ${position}`
                    : "Position: —"
            );

            setText(
                "firstName",
                getField(
                    staff,
                    "first_name",
                    "firstName"
                )
            );

            setText(
                "lastName",
                getField(
                    staff,
                    "last_name",
                    "lastName"
                )
            );

            setText(
                "middleName",
                getField(
                    staff,
                    "middle_name",
                    "middleName"
                )
            );

            setText(
                "gender",
                getField(staff, "gender")
            );

            setText(
                "dateOfBirth",
                formatDate(
                    getField(
                        staff,
                        "date_of_birth",
                        "dateOfBirth"
                    )
                )
            );

            setText(
                "phone",
                getField(
                    staff,
                    "phone"
                )
            );

            setText(
                "email",
                getField(
                    staff,
                    "email"
                )
            );

            setText(
                "address",
                getField(
                    staff,
                    "address"
                )
            );

            setText(
                "employmentStaffNumber",
                staffNumber
            );

            setText(
                "position",
                position
            );

            setText(
                "department",
                department
            );

            setText(
                "employmentType",
                getField(
                    staff,
                    "employment_type",
                    "employmentType"
                )
            );

            setText(
                "dateEmployed",
                formatDate(
                    getField(
                        staff,
                        "employment_date",
                        "employmentDate",
                        "date_employed",
                        "dateEmployed"
                    )
                )
            );

            setText(
                "qualification",
                getField(
                    staff,
                    "qualification"
                )
            );

            setText(
                "employmentStatus",
                formatStatus(status)
            );

            setText(
                "createdAt",
                formatDate(
                    getField(
                        staff,
                        "created_at",
                        "createdAt"
                    )
                )
            );

            setText(
                "updatedAt",
                formatDate(
                    getField(
                        staff,
                        "updated_at",
                        "updatedAt"
                    )
                )
            );

            renderPhoto(staff, fullName);
            renderStatus(status);

            document
                .getElementById("loading")
                .classList.add("d-none");

            document
                .getElementById("profileContainer")
                .classList.remove("d-none");
        }

        async function loadStaff() {
            hideError();

            staffId = getStaffId();

            if (!staffId) {
                document
                    .getElementById("loading")
                    .classList.add("d-none");

                showError(
                    "No staff ID was provided."
                );

                return;
            }

            try {
                const response = await fetch(
                    `${API_BASE}/staff/${encodeURIComponent(staffId)}`,
                    {
                        method: "GET",
                        headers: authHeaders()
                    }
                );

                if (response.status === 401) {
                    throw new Error(
                        "Your session has expired. Please log in again."
                    );
                }

                const result = await response.json();

                if (!response.ok) {
                    throw new Error(
                        result.message ||
                        "Unable to load staff profile."
                    );
                }

                const staff = getResponseData(result);

                if (!staff || typeof staff !== "object") {
                    throw new Error(
                        "The server returned an invalid staff record."
                    );
                }

                renderProfile(staff);

            } catch (error) {
                console.error(
                    "Load staff profile error:",
                    error
                );

                document
                    .getElementById("loading")
                    .classList.add("d-none");

                showError(
                    error.message ||
                    "Unable to load staff profile."
                );
            }
        }

        function fillEditForm(staff) {
            document.getElementById("editStaffNumber").value =
                getField(
                    staff,
                    "staff_number",
                    "staffNumber"
                );

            document.getElementById("editFirstName").value =
                getField(
                    staff,
                    "first_name",
                    "firstName"
                );

            document.getElementById("editLastName").value =
                getField(
                    staff,
                    "last_name",
                    "lastName"
                );

            document.getElementById("editMiddleName").value =
                getField(
                    staff,
                    "middle_name",
                    "middleName"
                );

            document.getElementById("editGender").value =
                getField(
                    staff,
                    "gender"
                );

            document.getElementById("editDateOfBirth").value =
                formatDateInput(
                    getField(
                        staff,
                        "date_of_birth",
                        "dateOfBirth"
                    )
                );

            document.getElementById("editPhone").value =
                getField(
                    staff,
                    "phone"
                );

            document.getElementById("editEmail").value =
                getField(
                    staff,
                    "email"
                );

            document.getElementById("editAddress").value =
                getField(
                    staff,
                    "address"
                );

            document.getElementById("editPosition").value =
                getField(
                    staff,
                    "position"
                );

            document.getElementById("editEmploymentType").value =
                getField(
                    staff,
                    "employment_type",
                    "employmentType"
                );

            document.getElementById("editDateEmployed").value =
                formatDateInput(
                    getField(
                        staff,
                        "employment_date",
                        "employmentDate",
                        "date_employed",
                        "dateEmployed"
                    )
                );

            document.getElementById("editQualification").value =
                getField(
                    staff,
                    "qualification"
                );
        }

        function openEditModal() {
            if (!currentStaff) {
                showToast(
                    "Staff profile is not loaded.",
                    "error"
                );

                return;
            }

            hideEditError();

            fillEditForm(currentStaff);

            editModalInstance =
                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById("editModal")
                );

            editModalInstance.show();
        }

        function closeEditModal() {
            if (editModalInstance) {
                editModalInstance.hide();
            }
        }

        function setSavingState(isSaving) {
            const button =
                document.getElementById(
                    "saveChangesButton"
                );

            if (!button) {
                return;
            }

            button.disabled = isSaving;

            button.innerHTML = isSaving
                ? `<span class="spinner-border spinner-border-sm me-1" role="status"></span> Saving...`
                : `<i class="bi bi-check2-circle me-1"></i> Save Changes`;
        }

        async function updateStaff(event) {
            event.preventDefault();

            if (!staffId) {
                showEditError(
                    "No staff ID was provided."
                );

                return;
            }

            hideEditError();
            setSavingState(true);

            const payload = {
                firstName:
                    document
                        .getElementById("editFirstName")
                        .value
                        .trim(),

                lastName:
                    document
                        .getElementById("editLastName")
                        .value
                        .trim(),

                middleName:
                    document
                        .getElementById("editMiddleName")
                        .value
                        .trim(),

                gender:
                    document
                        .getElementById("editGender")
                        .value,

                dateOfBirth:
                    document
                        .getElementById("editDateOfBirth")
                        .value || null,

                phone:
                    document
                        .getElementById("editPhone")
                        .value
                        .trim(),

                email:
                    document
                        .getElementById("editEmail")
                        .value
                        .trim(),

                address:
                    document
                        .getElementById("editAddress")
                        .value
                        .trim(),

                position:
                    document
                        .getElementById("editPosition")
                        .value
                        .trim(),

                employmentType:
                    document
                        .getElementById("editEmploymentType")
                        .value
                        .trim(),

                employmentDate:
                    document
                        .getElementById("editDateEmployed")
                        .value || null,

                qualification:
                    document
                        .getElementById("editQualification")
                        .value
                        .trim()
            };

            if (!payload.firstName) {
                showEditError(
                    "First name is required."
                );

                setSavingState(false);

                return;
            }

            if (!payload.lastName) {
                showEditError(
                    "Last name is required."
                );

                setSavingState(false);

                return;
            }

            try {
                const response = await fetch(
                    `${API_BASE}/staff/${encodeURIComponent(staffId)}`,
                    {
                        method: "PUT",
                        headers: authHeaders(),
                        body: JSON.stringify(payload)
                    }
                );

                if (response.status === 401) {
                    throw new Error(
                        "Your session has expired. Please log in again."
                    );
                }

                const result = await response.json();

                if (!response.ok) {
                    throw new Error(
                        result.message ||
                        "Unable to update staff profile."
                    );
                }

                const updatedStaff =
                    getResponseData(result);

                if (
                    updatedStaff &&
                    typeof updatedStaff === "object"
                ) {
                    renderProfile(updatedStaff);
                } else {
                    await loadStaff();
                }

                closeEditModal();

                showToast(
                    "Staff profile updated successfully."
                );

            } catch (error) {
                console.error(
                    "Update staff profile error:",
                    error
                );

                showEditError(
                    error.message ||
                    "Unable to update staff profile."
                );

            } finally {
                setSavingState(false);
            }
        }

        async function changeStatus(status) {
            if (!staffId) {
                return;
            }

            const action =
                status === "active"
                    ? "activate"
                    : "deactivate";

            const confirmed = window.confirm(
                `Are you sure you want to ${action} this staff member?`
            );

            if (!confirmed) {
                return;
            }

            try {
                const response = await fetch(
                    `${API_BASE}/staff/${encodeURIComponent(staffId)}`,
                    {
                        method: "PUT",
                        headers: authHeaders(),
                        body: JSON.stringify({
                            status
                        })
                    }
                );

                if (response.status === 401) {
                    throw new Error(
                        "Your session has expired. Please log in again."
                    );
                }

                const result = await response.json();

                if (!response.ok) {
                    throw new Error(
                        result.message ||
                        `Unable to ${action} staff member.`
                    );
                }

                const updatedStaff =
                    getResponseData(result);

                if (
                    updatedStaff &&
                    typeof updatedStaff === "object"
                ) {
                    renderProfile(updatedStaff);
                } else {
                    await loadStaff();
                }

                showToast(
                    `Staff member ${action}d successfully.`
                );

            } catch (error) {
                console.error(
                    "Change staff status error:",
                    error
                );

                showToast(
                    error.message ||
                    `Unable to ${action} staff member.`,
                    "error"
                );
            }
        }

        function initialiseSidebar() {
            const sidebar =
                document.getElementById("sidebar");

            const overlay =
                document.getElementById("sidebarOverlay");

            const toggle =
                document.getElementById("sidebarToggle");

            toggle.addEventListener(
                "click",
                function () {
                    sidebar.classList.toggle("show");
                    overlay.classList.toggle("show");
                }
            );

            overlay.addEventListener(
                "click",
                function () {
                    sidebar.classList.remove("show");
                    overlay.classList.remove("show");
                }
            );
        }

        document.addEventListener(
            "DOMContentLoaded",
            function () {
                initialiseSidebar();

                document
                    .getElementById("editForm")
                    .addEventListener(
                        "submit",
                        updateStaff
                    );

                loadStaff();
            }
        );
    </script>
