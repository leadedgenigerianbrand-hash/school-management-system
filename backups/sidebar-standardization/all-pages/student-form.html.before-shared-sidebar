                                    </label>

                                    <input type="email" class="form-control" id="email" name="email"
                                        autocomplete="email">

                                </div>

                                <div class="col-md-6">

                                    <label for="phone" class="form-label">
                                        Phone Number
                                    </label>

                                    <input type="tel" class="form-control" id="phone" name="phone" autocomplete="tel">

                                </div>

                                <div class="col-12">

                                    <label for="address" class="form-label">
                                        Address
                                    </label>

                                    <textarea class="form-control" id="address" name="address" rows="3"
                                        autocomplete="street-address"></textarea>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="form-card">

                        <div class="form-card-header">
                            Student Photograph
                        </div>

                        <div class="form-card-body">

                            <div class="photo-preview" id="photoPreview">

                                <span>
                                    No photo selected
                                </span>

                            </div>

                            <input type="file" class="form-control" id="photo" name="photo"
                                accept="image/jpeg,image/png,image/webp,image/gif">

                            <small class="text-muted">
                                Maximum file size: 5MB.
                            </small>

                        </div>

                    </div>

                    <div class="form-card">

                        <div class="form-card-header">
                            Additional Information
                        </div>

                        <div class="form-card-body">

                            <label for="notes" class="form-label">
                                Notes
                            </label>

                            <textarea class="form-control" id="notes" name="notes" rows="5"
                                placeholder="Additional information about the student..."></textarea>

                        </div>

                    </div>

                    <div class="form-card">

                        <div class="form-card-body">

                            <div class="form-actions">

                                <a href="students.html" class="btn btn-outline-secondary">
                                    <i class="bi bi-x-lg me-1"></i>
                                    Cancel
                                </a>

                                <button type="reset" class="btn btn-outline-warning" id="resetBtn">

                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                    Reset

                                </button>

                                <button type="submit" class="btn btn-primary" id="saveStudentBtn">

                                    <i class="bi bi-check-lg me-1"></i>
                                    Save Student

                                </button>

                            </div>

                        </div>

                    </div>

                </form>

            </div>

        </main>

    </div>

