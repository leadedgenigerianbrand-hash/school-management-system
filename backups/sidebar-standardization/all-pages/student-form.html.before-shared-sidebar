                    <i class="bi bi-key-fill"></i>
                    <span>Permissions</span>
                </a>

                <a href="profile.html" class="sidebar-link">
                    <i class="bi bi-person-circle"></i>
                    <span>Profile</span>
                </a>

                <a href="settings.html" class="sidebar-link">
                    <i class="bi bi-gear-fill"></i>
                    <span>Settings</span>
                </a>

            </div>

        </aside>

        <div id="sidebarOverlay"></div>

        <main class="sms-main">

            <header class="topbar">

                <div>
                    <button type="button" id="mobileSidebarBtn" class="btn btn-light border d-lg-none"
                        aria-label="Open navigation menu" title="Open navigation menu">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                </div>

                <div class="topbar-title">
                    Student Management
                </div>

                <div class="topbar-user">
                    <span id="loggedInUser">User</span>
                </div>

            </header>

            <div class="form-page">

                <div class="page-header">

                    <div>

                        <h1 id="pageTitle">
                            Add Student
                        </h1>

                        <p id="pageDescription">
                            Register a student and assign the student to the appropriate academic class.
                        </p>

                    </div>

                    <a href="students.html" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Students
                    </a>

                </div>

                <div id="alertArea" aria-live="polite" aria-atomic="true"></div>

                <form id="studentForm" novalidate enctype="multipart/form-data">

                    <div class="form-card">

                        <div class="form-card-header">
                            Basic Information
                        </div>

                        <div class="form-card-body">

                            <div class="row g-3">

                                <div class="col-md-4">

                                    <label for="admission_number" class="form-label required">
                                        Admission Number
                                    </label>

                                    <input type="text" class="form-control" id="admission_number"
                                        name="admission_number" autocomplete="off" required>

                                </div>

                                <div class="col-md-4">

                                    <label for="first_name" class="form-label required">
                                        First Name
                                    </label>

                                    <input type="text" class="form-control" id="first_name" name="first_name"
                                        autocomplete="given-name" required>

                                </div>

                                <div class="col-md-4">

                                    <label for="middle_name" class="form-label">
                                        Middle Name
                                    </label>

                                    <input type="text" class="form-control" id="middle_name" name="middle_name"
                                        autocomplete="additional-name">

                                </div>

                                <div class="col-md-4">

                                    <label for="last_name" class="form-label required">
                                        Last Name
                                    </label>

                                    <input type="text" class="form-control" id="last_name" name="last_name"
                                        autocomplete="family-name" required>

                                </div>

                                <div class="col-md-4">

                                    <label for="gender" class="form-label">
                                        Gender
                                    </label>

                                    <select class="form-select" id="gender" name="gender">

                                        <option value="">
                                            Select gender
                                        </option>

                                        <option value="Male">
                                            Male
                                        </option>

                                        <option value="Female">
                                            Female
                                        </option>

                                    </select>

                                </div>

                                <div class="col-md-4">

                                    <label for="date_of_birth" class="form-label">
                                        Date of Birth
                                    </label>

                                    <input type="date" class="form-control" id="date_of_birth" name="date_of_birth">

                                </div>

                                <div class="col-md-4">

                                    <label for="nationality" class="form-label">
                                        Nationality
                                    </label>

                                    <input type="text" class="form-control" id="nationality" name="nationality"
                                        value="Nigerian" autocomplete="country-name">

                                </div>

                                <div class="col-md-4">

                                    <label for="state_of_origin" class="form-label">
                                        State of Origin
                                    </label>

                                    <input type="text" class="form-control" id="state_of_origin" name="state_of_origin">

                                </div>

                                <div class="col-md-4">

                                    <label for="local_government" class="form-label">
                                        Local Government Area
                                    </label>

                                    <input type="text" class="form-control" id="local_government"
                                        name="local_government">

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="form-card">

                        <div class="form-card-header">
                            Academic Information
                        </div>

                        <div class="form-card-body">

                            <div class="academic-note">
                                Select academic information from the records already created for this school.
                                Classes and class arms are configurable by the school.
                            </div>

                            <div class="row g-3">

                                <div class="col-md-4">

                                    <label for="academic_level" class="form-label required">
                                        Academic Level
                                    </label>

                                    <select class="form-select" id="academic_level" name="academic_level" required>

                                        <option value="">
                                            Loading academic levels...
                                        </option>

                                    </select>

                                </div>

                                <div class="col-md-4">

                                    <label for="academic_session" class="form-label required">

                                        Academic Session

                                    </label>

                                    <select class="form-select" id="academic_session" name="academic_session" required>

                                        <option value="">
                                            Loading academic sessions...
                                        </option>

                                    </select>

                                </div>

                                <div class="col-md-4">

                                    <label for="class_name" class="form-label required">
                                        Class
                                    </label>

                                    <select class="form-select" id="class_name" name="class_name" required disabled>

                                        <option value="">
                                            Select academic level first
                                        </option>

                                    </select>

                                </div>

                                <div class="col-md-4">

                                    <label for="class_arm" class="form-label">
                                        Class Arm
                                    </label>

                                    <select class="form-select" id="class_arm" name="class_arm" disabled>

                                        <option value="">
                                            Select class first
                                        </option>

                                    </select>

                                </div>

                                <div class="col-md-4">

                                    <label for="department" class="form-label">
                                        Department
                                    </label>

                                    <select class="form-select" id="department" name="department">

                                        <option value="">
                                            Loading departments...
                                        </option>

                                    </select>

                                    <small class="text-muted">
                                        Mainly applicable to SSS students.
                                    </small>

                                </div>

                                <div class="col-md-4">

                                    <label for="admission_date" class="form-label">
                                        Admission Date
                                    </label>

                                    <input type="date" class="form-control" id="admission_date" name="admission_date">

                                </div>

                                <div class="col-md-4">

                                    <label for="status" class="form-label required">
                                        Student Status
                                    </label>

                                    <select class="form-select" id="status" name="status" required>

                                        <option value="Active">
                                            Active
                                        </option>

                                        <option value="Inactive">
                                            Inactive
                                        </option>

                                        <option value="Graduated">
                                            Graduated
                                        </option>

                                        <option value="Withdrawn">
                                            Withdrawn
                                        </option>

                                        <option value="Transferred">
                                            Transferred
                                        </option>

                                    </select>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="form-card">

                        <div class="form-card-header">
                            Contact Information
                        </div>

                        <div class="form-card-body">

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label for="email" class="form-label">
