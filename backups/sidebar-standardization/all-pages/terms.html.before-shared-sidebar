<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Academic Terms | School Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link href="../css/style.css" rel="stylesheet">
    <link href="../css/bootstrap-system.css" rel="stylesheet">
    <link href="../css/responsive.css" rel="stylesheet">

    <style>
        :root {
            --sidebar-width: 260px;
            --primary: #0d6efd;
            --sidebar-bg: #111827;
            --sidebar-hover: rgba(255, 255, 255, 0.09);
            --page-bg: #f5f7fb;
            --border-color: #e5e7eb;
            --text-dark: #1f2937;
            --text-muted: #6b7280;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--page-bg);
            color: var(--text-dark);
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Helvetica,
                Arial,
                sans-serif;
        }

        .app-wrapper {
            min-height: 100vh;
        }

        /* =========================================================
           SIDEBAR
        ========================================================= */

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: var(--sidebar-width);
            z-index: 1040;
            overflow-y: auto;
            background:
                linear-gradient(180deg,
                    #111827 0%,
                    #0f172a 100%);
            color: #ffffff;
            box-shadow: 4px 0 18px rgba(15, 23, 42, 0.08);
            transition: transform 0.25s ease;
        }

        .sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: transparent;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 10px;
        }

        .sidebar-brand {
            min-height: 76px;
            padding: 16px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            flex: 0 0 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(13, 110, 253, 0.18);
            color: #60a5fa;
            font-size: 21px;
        }

        .brand-text {
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        .brand-text strong {
            color: #ffffff;
            font-size: 14px;
            line-height: 1.25;
            font-weight: 700;
            white-space: nowrap;
        }

        .brand-text small {
            margin-top: 3px;
            color: rgba(255, 255, 255, 0.55);
            font-size: 11px;
            line-height: 1.2;
            white-space: nowrap;
        }

        .sidebar-section {
            padding: 18px 12px 0;
        }

        .sidebar-label {
            padding: 0 10px 8px;
            color: rgba(255, 255, 255, 0.42);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.09em;
            text-transform: uppercase;
        }

        .sidebar-link {
            min-height: 42px;
            margin-bottom: 4px;
            padding: 10px 12px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-radius: 8px;
            color: rgba(255, 255, 255, 0.72);
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition:
                background-color 0.18s ease,
                color 0.18s ease,
                transform 0.18s ease;
        }

        .sidebar-link i {
            width: 20px;
            flex: 0 0 20px;
            text-align: center;
            font-size: 16px;
        }

        .sidebar-link:hover {
            background: var(--sidebar-hover);
            color: #ffffff;
        }

        .sidebar-link.active {
            background: rgba(13, 110, 253, 0.18);
            color: #ffffff;
            box-shadow: inset 3px 0 0 #0d6efd;
        }

        .sidebar-link.active i {
            color: #60a5fa;
        }

        /* =========================================================
           SIDEBAR OVERLAY
        ========================================================= */

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 1035;
            background: rgba(15, 23, 42, 0.48);
        }

        /* =========================================================
           MAIN AREA
        ========================================================= */

        .main-content {
            min-height: 100vh;
            margin-left: var(--sidebar-width);
        }

        /* =========================================================
           TOPBAR
        ========================================================= */

        .topbar {
            min-height: 76px;
            position: sticky;
            top: 0;
            z-index: 1020;
            padding: 12px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
        }

        .topbar-title {
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .topbar-title h1 {
            margin: 0;
            color: #111827;
            font-size: 20px;
            font-weight: 700;
            line-height: 1.2;
        }

        .topbar-title small {
            display: block;
            margin-top: 3px;
            color: var(--text-muted);
            font-size: 12px;
        }

        .sidebar-toggle {
            display: none;
            width: 40px;
            height: 40px;
            padding: 0;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background: #ffffff;
            color: #374151;
            align-items: center;
            justify-content: center;
            font-size: 21px;
        }

        .sidebar-toggle:hover {
            background: #f8fafc;
        }

        .user-area {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .user-info {
            min-width: 0;
        }

        .user-info strong {
            display: block;
            color: #111827;
            font-size: 13px;
            font-weight: 700;
        }

        .user-info small {
            display: block;
            margin-top: 2px;
            color: var(--text-muted);
            font-size: 11px;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eaf2ff;
            color: var(--primary);
            font-size: 18px;
        }

        /* =========================================================
           PAGE CONTENT
        ========================================================= */

        .page-content {
            padding: 28px;
        }

        .page-heading {
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .page-heading>div {
            min-width: 0;
        }

        .page-heading h2 {
            margin: 0;
            color: #111827;
            font-size: 24px;
            font-weight: 700;
            line-height: 1.25;
        }

        .page-heading p {
            margin: 6px 0 0;
            color: var(--text-muted);
            font-size: 13px;
        }

        #addTermButton {
            min-height: 42px;
            padding: 9px 18px;
            flex-shrink: 0;
            border-radius: 8px;
            background-color: #0d6efd;
            border-color: #0d6efd;
            color: #ffffff;
            font-size: 13px;
            font-weight: 600;
            box-shadow: 0 2px 5px rgba(13, 110, 253, 0.14);
        }

        #addTermButton:hover {
            background-color: #0b5ed7;
            border-color: #0a58ca;
        }

        /* =========================================================
           ALERT
        ========================================================= */

        #alertMessage {
            margin-bottom: 20px;
            border-radius: 8px;
            font-size: 13px;
        }

        /* =========================================================
           STATISTICS
        ========================================================= */

        .stat-card {
            min-height: 142px;
            padding: 20px;
            position: relative;
            overflow: hidden;
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        }

        .stat-icon {
            width: 42px;
            height: 42px;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            background: #edf4ff;
            color: var(--primary);
            font-size: 19px;
        }

        .stat-label {
            color: var(--text-muted);
            font-size: 12px;
            font-weight: 600;
        }

        .stat-value {
            margin-top: 4px;
            color: #111827;
            font-size: 25px;
            font-weight: 700;
            line-height: 1.1;
        }

        /* =========================================================
           TOOLBAR
        ========================================================= */

        .toolbar-card {
            margin-top: 24px;
            padding: 16px;
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        }

        .search-wrapper {
            position: relative;
        }

        .search-wrapper>i {
            position: absolute;
            top: 50%;
            left: 13px;
            z-index: 2;
            color: #9ca3af;
            font-size: 15px;
            transform: translateY(-50%);
            pointer-events: none;
        }

        .search-wrapper .form-control {
            padding-left: 38px;
        }

        .toolbar-card .form-control,
        .toolbar-card .form-select {
            min-height: 42px;
            border-color: #dfe3e8;
            border-radius: 8px;
            font-size: 13px;
        }

        .toolbar-card .form-control:focus,
        .toolbar-card .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.1);
        }

        #refreshTermsButton {
            min-height: 42px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
        }

        /* =========================================================
           TABLE
        ========================================================= */

        .table-card {
            margin-top: 24px;
            overflow: hidden;
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        }

        .table-card-header {
            min-height: 62px;
            padding: 15px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            border-bottom: 1px solid var(--border-color);
        }

        .table-card-header h3 {
            margin: 0;
            color: #111827;
            font-size: 15px;
            font-weight: 700;
        }

        .table-count {
            padding: 5px 9px;
            border-radius: 6px;
            background: #f3f4f6;
            color: #6b7280;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }

        .table-card .table {
            color: #374151;
            font-size: 13px;
        }

        .table-card .table thead th {
            padding: 13px 16px;
            background: #f8fafc;
            border-bottom: 1px solid var(--border-color);
            color: #6b7280;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.02em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .table-card .table tbody td {
            padding: 14px 16px;
            border-color: #eef0f3;
            vertical-align: middle;
        }

        .table-card .table tbody tr:hover {
            background: #fafcff;
        }

        .loading {
            padding: 35px 16px !important;
            color: var(--text-muted);
            text-align: center;
        }

        /* =========================================================
           MODAL
        ========================================================= */

        .modal-content {
            overflow: hidden;
            border: 0;
            border-radius: 12px;
            box-shadow: 0 18px 50px rgba(15, 23, 42, 0.18);
        }

        .modal-header {
            padding: 18px 22px;
            border-bottom: 1px solid var(--border-color);
        }

        .modal-title {
            color: #111827;
            font-size: 17px;
            font-weight: 700;
        }

        .modal-body {
            padding: 22px;
        }

        .modal-footer {
            padding: 15px 22px;
            background: #f8fafc;
            border-top: 1px solid var(--border-color);
        }

        .modal .form-label {
            margin-bottom: 6px;
            color: #374151;
            font-size: 12px;
            font-weight: 600;
        }

        .modal .form-control,
        .modal .form-select {
            min-height: 42px;
            border-color: #dfe3e8;
            border-radius: 8px;
            font-size: 13px;
        }

        .modal .form-control:focus,
        .modal .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.1);
        }

        #saveTermButton {
            min-height: 40px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
        }

        #cancelTermButton {
            min-height: 40px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
        }

        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @media (max-width: 991.98px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .sidebar.show {
                transform: translateX(0);
            }

            .sidebar-overlay.show {
                display: block;
            }

            .main-content {
                margin-left: 0;
            }

            .sidebar-toggle {
                display: inline-flex;
            }

            .topbar {
                padding: 12px 20px;
            }

            .page-content {
                padding: 22px 20px;
            }
        }

        @media (max-width: 767.98px) {
            .topbar {
                min-height: 68px;
            }

            .topbar-title h1 {
                font-size: 17px;
            }

            .topbar-title small {
                display: none;
            }

            .user-info {
                display: none;
            }

            .page-heading {
                align-items: flex-start;
                flex-direction: column;
            }

            #addTermButton {
                width: 100%;
            }

            .page-heading h2 {
                font-size: 21px;
            }

            .page-content {
                padding: 18px 15px;
            }

            .table-card-header {
                align-items: flex-start;
                flex-direction: column;
            }
        }

        @media (max-width: 575.98px) {
            .brand-text strong {
                font-size: 13px;
            }

            .brand-text small {
                font-size: 10px;
            }

            .sidebar {
                width: 280px;
            }

            .stat-card {
                min-height: 125px;
            }

            .toolbar-card {
                padding: 12px;
            }

            .modal-body {
                padding: 18px;
            }

            .modal-footer {
                padding: 13px 18px;
            }
        }
    </style>
</head>

<body>

    <div class="app-wrapper">

        <!-- =====================================================
             SIDEBAR
        ====================================================== -->
        <aside id="sidebar" class="sidebar">

            <div class="sidebar-brand">
                <div class="brand-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>

                <div class="brand-text">
                    <strong>School Management</strong>
                    <small>Administration Portal</small>
                </div>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-label">Main</div>

                <a href="/pages/dashboard.html" class="sidebar-link">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>

                <a href="/pages/students.html" class="sidebar-link">
                    <i class="bi bi-people-fill"></i>
                    <span>Students</span>
                </a>

                <a href="/pages/staff.html" class="sidebar-link">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>Staff</span>
                </a>

                <a href="/pages/guardians.html" class="sidebar-link">
                    <i class="bi bi-person-hearts"></i>
                    <span>Guardians</span>
                </a>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-label">Academic</div>

                <a href="/pages/classes.html" class="sidebar-link">
                    <i class="bi bi-building"></i>
                    <span>Classes</span>
                </a>

                <a href="/pages/class-arms.html" class="sidebar-link">
                    <i class="bi bi-diagram-3-fill"></i>
                    <span>Class Arms</span>
                </a>

                <a href="/pages/departments.html" class="sidebar-link">
                    <i class="bi bi-diagram-2-fill"></i>
                    <span>Departments</span>
                </a>

                <a href="/pages/subjects.html" class="sidebar-link">
                    <i class="bi bi-book-fill"></i>
                    <span>Subjects</span>
                </a>

                <a href="/pages/academic-sessions.html" class="sidebar-link">
                    <i class="bi bi-calendar3"></i>
                    <span>Academic Sessions</span>
                </a>

                <a href="/pages/terms.html" class="sidebar-link active">
                    <i class="bi bi-calendar2-week-fill"></i>
                    <span>Terms</span>
                </a>

                <a href="/pages/attendance.html" class="sidebar-link">
                    <i class="bi bi-calendar-check-fill"></i>
                    <span>Attendance</span>
                </a>

                <a href="/pages/results.html" class="sidebar-link">
                    <i class="bi bi-bar-chart-fill"></i>
                    <span>Results</span>
                </a>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-label">Finance & Records</div>

                <a href="/pages/fees.html" class="sidebar-link">
                    <i class="bi bi-wallet2"></i>
                    <span>Fees & Payments</span>
                </a>

                <a href="/pages/documents.html" class="sidebar-link">
                    <i class="bi bi-folder-fill"></i>
                    <span>Documents</span>
                </a>

                <a href="/pages/reports.html" class="sidebar-link">
                    <i class="bi bi-file-earmark-bar-graph-fill"></i>
                    <span>Reports</span>
                </a>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-label">Administration</div>

                <a href="/pages/users.html" class="sidebar-link">
                    <i class="bi bi-person-gear"></i>
                    <span>Users</span>
                </a>

                <a href="/pages/roles.html" class="sidebar-link">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>Roles</span>
                </a>

                <a href="/pages/permissions.html" class="sidebar-link">
                    <i class="bi bi-key-fill"></i>
                    <span>Permissions</span>
                </a>

                <a href="/pages/profile.html" class="sidebar-link">
                    <i class="bi bi-person-circle"></i>
                    <span>My Profile</span>
                </a>

                <a href="/pages/settings.html" class="sidebar-link">
                    <i class="bi bi-gear-fill"></i>
                    <span>Settings</span>
                </a>

                <a href="#" id="logoutButton" class="sidebar-link">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>
            </div>

        </aside>

        <div id="sidebarOverlay" class="sidebar-overlay"></div>

        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->
        <main class="main-content">

            <!-- TOPBAR -->
            <header class="topbar">

                <div class="topbar-title">

                    <button id="sidebarToggle" class="sidebar-toggle" type="button" aria-label="Open navigation">

                        <i class="bi bi-list"></i>

                    </button>

                    <div>
                        <h1>Academic Terms</h1>
                        <small>Manage terms and academic periods</small>
                    </div>

                </div>

                <div class="user-area">

                    <div class="user-info text-end">
                        <strong id="userName">Administrator</strong>
                        <small id="userRole">School Administrator</small>
                    </div>

                    <div class="user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>

                </div>

            </header>

            <!-- PAGE CONTENT -->
            <div class="page-content">

                <!-- PAGE HEADING -->
                <div class="page-heading">

                    <div>
                        <h2>Academic Terms</h2>
                        <p>
                            Manage the academic terms used by your school.
                        </p>
                    </div>

                    <button type="button" class="btn btn-primary" id="addTermButton">

                        <i class="bi bi-plus-lg me-2"></i>
                        Add Term

                    </button>

                </div>

                <!-- ALERT -->
                <div id="alertMessage" class="alert d-none" role="alert">
                </div>

                <!-- STATISTICS -->
                <div class="row g-3">

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card">

                            <div class="stat-icon">
                                <i class="bi bi-calendar2-week"></i>
                            </div>

                            <div class="stat-label">
                                Total Terms
                            </div>

                            <div id="totalTerms" class="stat-value">
                                0
                            </div>

                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card">

                            <div class="stat-icon">
                                <i class="bi bi-check-circle"></i>
                            </div>

                            <div class="stat-label">
                                Active Terms
                            </div>

                            <div id="activeTerms" class="stat-value">
                                0
                            </div>

                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card">

                            <div class="stat-icon">
                                <i class="bi bi-clock-history"></i>
                            </div>

                            <div class="stat-label">
                                Upcoming Terms
                            </div>

                            <div id="upcomingTerms" class="stat-value">
                                0
                            </div>

                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card">

                            <div class="stat-icon">
                                <i class="bi bi-check2-all"></i>
                            </div>

                            <div class="stat-label">
                                Completed Terms
                            </div>

                            <div id="completedTerms" class="stat-value">
                                0
                            </div>

                        </div>
                    </div>

                </div>

                <!-- TOOLBAR -->
                <section class="toolbar-card">

                    <div class="row g-2 align-items-center">

                        <div class="col-12 col-lg">

                            <div class="search-wrapper">

                                <i class="bi bi-search"></i>

                                <input type="text" id="searchInput" class="form-control"
                                    placeholder="Search academic terms...">

                            </div>

                        </div>

                        <div class="col-12 col-sm-6 col-lg-3">

                            <select id="statusFilter" class="form-select">

                                <option value="">
                                    All Statuses
                                </option>

                                <option value="active">
                                    Active
                                </option>

                                <option value="upcoming">
                                    Upcoming
                                </option>

                                <option value="completed">
                                    Completed
                                </option>

                                <option value="inactive">
                                    Inactive
                                </option>

                            </select>

                        </div>

                        <div class="col-12 col-sm-6 col-lg-auto">

                            <button type="button" class="btn btn-light border w-100 px-4" id="refreshTermsButton">

                                <i class="bi bi-arrow-clockwise me-1"></i>
                                Refresh

                            </button>

                        </div>

                    </div>

                </section>

                <!-- TERMS TABLE -->
                <section class="table-card">

                    <div class="table-card-header">

                        <h3>
                            <i class="bi bi-calendar2-week me-2 text-primary"></i>
                            Academic Terms
                        </h3>

                        <span id="tableCount" class="table-count">
                            0 terms
                        </span>

                    </div>

                    <div class="table-responsive">

                        <table class="table mb-0">

                            <thead>

                                <tr>
                                    <th>Term</th>
                                    <th>Order</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Current</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>

                            </thead>

                            <tbody id="termsTableBody">

                                <tr>

                                    <td colspan="7" class="loading">

                                        <div class="spinner-border spinner-border-sm text-primary me-2">
                                        </div>

