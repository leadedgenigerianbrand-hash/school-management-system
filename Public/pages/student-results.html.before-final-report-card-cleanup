<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Results | School Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <link rel="stylesheet" href="../css/style.css">
    <link rel="stylesheet" href="../css/students.css">

    <style>
        body {
            background: #f5f7fb;
        }

        .app-shell {
            min-height: 100vh;
            display: flex;
        }

        .sidebar {
            width: 260px;
            background: #172033;
            color: #fff;
            min-height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            z-index: 1040;
            overflow-y: auto;
        }

        .sidebar-brand {
            padding: 22px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .sidebar-brand h5 {
            margin: 0;
            font-weight: 700;
        }

        .sidebar-brand small {
            color: #aeb8ca;
        }

        .sidebar-section {
            padding: 18px 14px 6px;
            color: #7f8ba1;
            font-size: 0.72rem;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.08em;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 11px;
            color: #cbd3e1;
            text-decoration: none;
            padding: 10px 16px;
            margin: 2px 10px;
            border-radius: 8px;
            font-size: 0.9rem;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #26334c;
            color: #fff;
        }

        .sidebar a i {
            width: 20px;
            text-align: center;
        }

        .main-content {
            margin-left: 260px;
            width: calc(100% - 260px);
            min-height: 100vh;
        }

        .topbar {
            background: #fff;
            border-bottom: 1px solid #e7eaf0;
            min-height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .page-content {
            padding: 28px;
        }

        .content-card {
            background: #fff;
            border: 1px solid #e7eaf0;
            border-radius: 14px;
            box-shadow: 0 2px 8px rgba(20, 30, 50, 0.04);
        }

        .student-summary {
            background: #f8f9fc;
            border: 1px solid #e7eaf0;
            border-radius: 12px;
        }

        .summary-label {
            color: #6c7484;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 3px;
        }

        .summary-value {
            color: #182033;
            font-weight: 600;
        }

        .stat-card {
            background: #fff;
            border: 1px solid #e7eaf0;
            border-radius: 14px;
            padding: 20px;
            height: 100%;
            box-shadow: 0 2px 8px rgba(20, 30, 50, 0.04);
        }

        .stat-card .icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: #eef2ff;
            color: #4154d8;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            margin-bottom: 14px;
        }

        .stat-card .label {
            color: #6c7484;
            font-size: 0.82rem;
            margin-bottom: 5px;
        }

        .stat-card strong {
            font-size: 1.45rem;
            color: #182033;
        }

        .results-table th {
            background: #f8f9fc;
            color: #687386;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            white-space: nowrap;
        }

        .results-table td {
            vertical-align: middle;
        }

        .grade-badge {
            min-width: 38px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            border-radius: 7px;
            padding: 5px 9px;
            font-weight: 700;
        }

        .grade-pass {
            background: #e8f7ee;
            color: #198754;
        }

        .grade-fail {
            background: #fdecec;
            color: #dc3545;
        }

        .result-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 20px;
            padding: 6px 12px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .result-status.draft {
            background: #fff3cd;
            color: #856404;
        }

        .result-status.published {
            background: #d1e7dd;
            color: #0f5132;
        }

        .result-status.empty {
            background: #e9ecef;
            color: #495057;
        }

        .overall-result {
            background: #f8f9fc;
            border: 1px solid #e7eaf0;
            border-radius: 12px;
        }

        .overall-result .result-item {
            padding: 16px;
            border-right: 1px solid #e7eaf0;
        }

        .overall-result .result-item:last-child {
            border-right: 0;
        }

        .overall-label {
            color: #6c7484;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .overall-value {
            font-size: 1.35rem;
            font-weight: 700;
            color: #182033;
        }

        #pageMessage {
            display: none;
        }

        #resultLoading {
            display: none;
        }



        .mobile-menu {
            display: none;
        }

        .sidebar-overlay {
            display: none;
        }

        .empty-result {
            padding: 60px 20px;
            text-align: center;
            color: #6c7484;
        }

        .empty-result i {
            font-size: 2.5rem;
            margin-bottom: 12px;
        }

        @media (max-width: 991.98px) {
            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.2s ease;
            }

            .sidebar.show {
                transform: translateX(0);
            }

            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .mobile-menu {
                display: inline-flex;
            }

            .sidebar-overlay {
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, 0.45);
                z-index: 1030;
            }

            .sidebar-overlay.show {
                display: block;
            }

            .page-content {
                padding: 20px;
            }

            .overall-result .result-item {
                border-right: 0;
                border-bottom: 1px solid #e7eaf0;
            }

            .overall-result .result-item:last-child {
                border-bottom: 0;
            }
        }

        @media (max-width: 575.98px) {
            .topbar {
                padding: 0 16px;
            }

            .page-content {
                padding: 16px;
            }

            .page-title h1 {
                font-size: 1.45rem;
            }

            .table-responsive {
                border-radius: 10px;
            }
        }
    </style>

</head>

<body>

    <div class="app-shell">

        <aside class="sidebar" id="sidebar">

            <div class="sidebar-brand">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-mortarboard-fill fs-4"></i>

                    <div>
                        <h5>School Management</h5>
                        <small>Administration Portal</small>
                    </div>
                </div>
            </div>

            <div class="sidebar-section">Main</div>

            <a href="/pages/dashboard.html">
                <i class="bi bi-grid-1x2-fill"></i>
                Dashboard
            </a>

            <a href="/pages/students.html" class="active">
                <i class="bi bi-people-fill"></i>
                Students
            </a>

            <a href="/pages/staff.html">
                <i class="bi bi-person-badge-fill"></i>
                Staff
            </a>

            <a href="/pages/guardians.html">
                <i class="bi bi-person-hearts"></i>
                Guardians
            </a>

            <div class="sidebar-section">Academic</div>

            <a href="/pages/classes.html">
                <i class="bi bi-building"></i>
                Classes
            </a>

            <a href="/pages/class-arms.html">
                <i class="bi bi-diagram-3-fill"></i>
                Class Arms
            </a>

            <a href="/pages/departments.html">
                <i class="bi bi-diagram-2-fill"></i>
                Departments
            </a>

            <a href="/pages/subjects.html">
                <i class="bi bi-book-fill"></i>
                Subjects
            </a>

            <a href="/pages/academic-levels.html">
                <i class="bi bi-layers-fill"></i>
                Academic Levels
            </a>

            <a href="/pages/academic-sessions.html">
                <i class="bi bi-calendar3"></i>
                Academic Sessions
            </a>

            <a href="/pages/terms.html">
                <i class="bi bi-calendar2-week"></i>
                Terms
            </a>

            <a href="/pages/attendance.html">
                <i class="bi bi-calendar-check-fill"></i>
                Attendance
            </a>

            <a href="/pages/results.html">
                <i class="bi bi-bar-chart-fill"></i>
                Results
            </a>

            <div class="sidebar-section">Finance & Records</div>

            <a href="/pages/fees.html">
                <i class="bi bi-wallet2"></i>
                Fees & Payments
            </a>

            <a href="/pages/documents.html">
                <i class="bi bi-folder-fill"></i>
                Documents
            </a>

            <a href="/pages/reports.html">
                <i class="bi bi-file-earmark-bar-graph-fill"></i>
                Reports
            </a>

            <div class="sidebar-section">Administration</div>

            <a href="/pages/users.html">
                <i class="bi bi-person-gear"></i>
                Users
            </a>

            <a href="/pages/roles.html">
                <i class="bi bi-shield-lock-fill"></i>
                Roles
            </a>

            <a href="/pages/permissions.html">
                <i class="bi bi-key-fill"></i>
                Permissions
            </a>

            <a href="/pages/profile.html">
                <i class="bi bi-person-circle"></i>
                My Profile
            </a>

            <a href="/pages/settings.html">
                <i class="bi bi-gear-fill"></i>
                Settings
            </a>

        </aside>

        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <main class="main-content">

            <header class="topbar">

                <div class="d-flex align-items-center gap-3">

                    <button class="btn btn-light mobile-menu" type="button" id="sidebarToggle"
                        aria-label="Open navigation menu">
                        <i class="bi bi-list fs-5"></i>
                    </button>

                    <div>
                        <strong class="d-block">
                            Student Results
                        </strong>

                        <small class="text-muted">
                            Academic performance and result history
                        </small>
                    </div>

                </div>

                <div class="d-flex align-items-center gap-3">

                    <span class="text-muted small d-none d-md-inline">
                        <i class="bi bi-person-circle me-1"></i>
                        <span id="userName">
                            Administrator
                        </span>
                    </span>

                    <button type="button" class="btn btn-outline-danger btn-sm" id="logoutButton">
                        <i class="bi bi-box-arrow-right me-1"></i>
                        Logout
                    </button>

                </div>

            </header>

            <div class="page-content">

                <div
                    class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 page-title">

                    <div>

                        <div class="d-flex align-items-center gap-2 mb-1">

                            <a href="/pages/students.html" id="backToProfileButton"
                                class="text-decoration-none text-muted" aria-label="Back to students">
                                <i class="bi bi-arrow-left"></i>
                            </a>

                            <h1 class="h3 mb-0 fw-bold">
                                Student Results
                            </h1>

                        </div>

                        <p id="studentSubtitle" class="text-muted mb-0">
                            Search for a student to view academic results.
                        </p>

                    </div>

                    <div class="d-flex flex-wrap gap-2">

                        <button type="button" class="btn btn-outline-primary" id="refreshButton">
                            <i class="bi bi-arrow-clockwise me-1"></i>
                            Refresh
                        </button>


                    </div>

                </div>

                <div id="pageMessage" class="alert mb-4" role="alert"></div>

                <div id="resultLoading" class="alert alert-info mb-4" role="status">
                    <div class="spinner-border spinner-border-sm me-2"></div>
                    Loading student result...
                </div>

                <div class="content-card mb-4">

                    <div class="p-4">

                        <div class="row g-3 align-items-end">

                            <div class="col-12 col-md-5">

                                <label for="studentIdentifier" class="form-label fw-semibold">
                                    Student Admission Number
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-person-vcard"></i>
                                    </span>

                                    <input type="text" class="form-control" id="studentIdentifier"
                                        placeholder="e.g. LMC001" autocomplete="off">

                                    <button type="button" class="btn btn-primary" id="searchStudentButton">
                                        <i class="bi bi-search me-1"></i>
                                        Search
                                    </button>

                                </div>

                                <div class="form-text">
                                    Enter the student's admission number.
                                </div>

                            </div>

                            <div class="col-12 col-md-3">

                                <label for="academicSessionId" class="form-label fw-semibold">
                                    Academic Session
                                </label>

                                <select class="form-select" id="academicSessionId">
                                    <option value="">
                                        Select academic session
                                    </option>
                                </select>

                            </div>

                            <div class="col-12 col-md-2">

                                <label for="termId" class="form-label fw-semibold">
                                    Term
                                </label>

                                <select class="form-select" id="termId">
                                    <option value="">
                                        Select term
                                    </option>
                                </select>

                            </div>

                            <div class="col-12 col-md-2">

                                <label class="form-label fw-semibold">
                                    Status
                                </label>

                                <div id="resultStatusContainer">

                                    <span class="result-status empty">
                                        <i class="bi bi-dash-circle"></i>
                                        Not Loaded
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div id="studentSummary" class="student-summary content-card mb-4">

                    <div class="p-4">

                        <div class="row g-3">

                            <div class="col-12 col-md-4">

                                <div class="summary-label">
                                    Student
                                </div>

                                <div class="summary-value" id="studentName">
                                    Not selected
                                </div>

                            </div>

                            <div class="col-6 col-md-2">

                                <div class="summary-label">
                                    Admission No.
                                </div>

                                <div class="summary-value" id="studentNumber">
                                    —
                                </div>

                            </div>

                            <div class="col-6 col-md-2">

                                <div class="summary-label">
                                    Class
                                </div>

                                <div class="summary-value" id="studentClass">
                                    —
                                </div>

                            </div>

                            <div class="col-6 col-md-2">

                                <div class="summary-label">
                                    Class Arm
                                </div>

                                <div class="summary-value" id="studentArm">
                                    —
                                </div>

                            </div>

                            <div class="col-6 col-md-2">

                                <div class="summary-label">
                                    Academic Level
                                </div>

                                <div class="summary-value" id="studentLevel">
                                    —
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div id="resultContent">

                    <div class="row g-3 mb-4">

                        <div class="col-6 col-xl-3">

                            <div class="stat-card">

                                <div class="icon">
                                    <i class="bi bi-book"></i>
                                </div>

                                <div class="label">
                                    Subjects
                                </div>

                                <strong id="subjectCount">
                                    0
                                </strong>

                            </div>

                        </div>

                        <div class="col-6 col-xl-3">

                            <div class="stat-card">

                                <div class="icon">
                                    <i class="bi bi-calculator"></i>
                                </div>

                                <div class="label">
                                    Overall Total
                                </div>

                                <strong id="overallTotal">
                                    0
                                </strong>

                            </div>

                        </div>

                        <div class="col-6 col-xl-3">

                            <div class="stat-card">

                                <div class="icon">
                                    <i class="bi bi-percent"></i>
                                </div>

                                <div class="label">
                                    Percentage
                                </div>

                                <strong id="overallPercentage">
                                    0%
                                </strong>

                            </div>

                        </div>

                        <div class="col-6 col-xl-3">

                            <div class="stat-card">

                                <div class="icon">
                                    <i class="bi bi-trophy"></i>
                                </div>

                                <div class="label">
                                    Position
                                </div>

                                <strong id="studentPosition">
                                    —
                                </strong>

                            </div>

                        </div>

                    </div>

                    <div class="content-card mb-4">

                        <div class="p-4 border-bottom">

                            <div class="d-flex flex-column flex-md-row justify-content-between gap-3">

                                <div>

                                    <div class="d-flex align-items-center gap-2">

                                        <div class="text-primary">
                                            <i class="bi bi-journal-text fs-4"></i>
                                        </div>

                                        <div>

                                            <h2 class="h5 fw-bold mb-1">
                                                Academic Results
                                            </h2>

                                            <p class="text-muted small mb-0">
                                                Subjects recorded for the selected academic session and term.
                                            </p>

                                        </div>

                                    </div>

                                </div>

                                <div class="d-flex align-items-center gap-2">

                                    <span class="text-muted small">
                                        Result:
                                    </span>

                                    <span class="result-status empty" id="tableResultStatus">
                                        <i class="bi bi-dash-circle"></i>
                                        Not Loaded
                                    </span>

                                </div>

                            </div>

                        </div>

                        <div class="table-responsive">

                            <table class="table table-hover mb-0 results-table">

                                <thead>

                                    <tr>

                                        <th class="ps-4">
                                            #
                                        </th>

                                        <th>
                                            Subject
                                        </th>

                                        <th>
                                            CA
                                        </th>

                                        <th>
                                            Exam
                                        </th>

                                        <th>
                                            Total
                                        </th>

                                        <th>
                                            Grade
                                        </th>

                                        <th>
                                            Remark
                                        </th>

                                    </tr>

                                </thead>

                                <tbody id="resultsTableBody">

                                    <tr>
                                        <td colspan="7">
                                            <div class="empty-result">
                                                <i class="bi bi-search d-block"></i>
                                                Search for a student to load the result.
                                            </div>
                                        </td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                    <div class="overall-result content-card mb-4">

                        <div class="row g-0">

                            <div class="col-6 col-md-3">

                                <div class="result-item">

                                    <div class="overall-label">
                                        Total Score
                                    </div>

                                    <div class="overall-value" id="summaryTotalScore">
                                        0
                                    </div>

                                </div>

                            </div>

                            <div class="col-6 col-md-3">

                                <div class="result-item">

                                    <div class="overall-label">
                                        Percentage
                                    </div>

                                    <div class="overall-value" id="summaryPercentage">
                                        0%
                                    </div>

                                </div>

                            </div>

                            <div class="col-6 col-md-3">

                                <div class="result-item">

                                    <div class="overall-label">
                                        Position
                                    </div>

                                    <div class="overall-value" id="summaryPosition">
                                        —
                                    </div>

                                </div>

                            </div>

                            <div class="col-6 col-md-3">

                                <div class="result-item">

                                    <div class="overall-label">
                                        Result Status
                                    </div>

                                    <div class="overall-value" id="summaryStatus">
                                        Not Loaded
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="content-card mb-4">

                        <div class="p-4">

                            <div
                                class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                                <div>

                                    <h2 class="h5 fw-bold mb-1">
                                        Result Actions
                                    </h2>

                                    <p class="text-muted small mb-0">
                                        Open the student's report card or print the displayed result.
                                    </p>

                                </div>

                                <div class="d-flex flex-wrap gap-2">

                                    <button type="button" class="btn btn-outline-secondary" id="printResultButton">
                                        <i class="bi bi-printer me-1"></i>
                                        Print Result
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </main>

    </div>

    <script src="../js/api.js"></script>
    <script src="../js/auth.js"></script>
    <script src="../js/student-results.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>