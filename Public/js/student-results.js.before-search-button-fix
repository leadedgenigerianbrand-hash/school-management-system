                                3,
                                1fr
                            );
                        gap: 12px;
                        margin-top: 22px;
                    }

                    .summary-box {
                        border: 1px solid #dee2e6;
                        padding: 14px;
                        text-align: center;
                        border-radius: 5px;
                    }

                    .summary-label {
                        display: block;
                        font-size: 12px;
                        color: #6c757d;
                        margin-bottom: 5px;
                    }

