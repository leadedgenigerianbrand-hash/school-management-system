    /* ==========================================================================
    REPORT CARD
    ========================================================================== */

    function getReportCardUrl() {
        const studentId =
            normalizeId(
                state.currentStudentId
            );

        if (!studentId) {
            return "";
        }

        const params =
            new URLSearchParams();

        params.set(
            "studentId",
            studentId
        );

        const reportCardId =
            normalizeId(
                state.currentReportCardId
            );

        if (reportCardId) {
            params.set(
                "reportCardId",
                reportCardId
            );
        }

        const sessionId =
            normalizeId(
                state.currentAcademicSessionId ||
                elements.sessionId?.value
            );

        const termId =
            normalizeId(
                state.currentTermId ||
                elements.termId?.value
            );

        if (sessionId) {
            params.set(
                "academicSessionId",
                sessionId
            );
        }

        if (termId) {
            params.set(
                "termId",
                termId
            );
        }

        return (
            `/pages/report-card.html?${params.toString()}`
        );
    }

    function openReportCard() {
        const url =
            getReportCardUrl();

        if (!url) {
            showMessage(
                "Find a student before opening the report card.",
                "warning"
            );

            return;
        }

        window.open(
            url,
            "_blank"
        );
    }

    function printReportCard() {
        openReportCard();
    }

    /* ==========================================================================
    PRINT CURRENT RESULT
    ========================================================================== */

