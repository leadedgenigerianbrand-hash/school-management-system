"use strict";

(function () {
    let school = {};
    let currentUser = {};

    let academicSessions = [];
    let terms = [];
    let currentSession = null;
    let currentTerm = null;

    const SCHOOL_LIST_ENDPOINT = "/schools";
    const AUTH_ME_ENDPOINT = "/auth/me";
    const ACADEMIC_SESSIONS_ENDPOINT = "/academic-sessions";
    const TERMS_ENDPOINT = "/terms";

    /* ==========================================================================
       INITIALIZATION
    ========================================================================== */

    async function initialize() {
        setupSettingsTabs();
        setupSidebar();
        setupSchoolForm();
        setupResetButton();
        setupLogout();

        currentUser = getStoredUser();

        populateUserInformation();

        await loadCurrentUser();
        await loadSchool();
        await loadAcademicSettings();
    }

    /* ==========================================================================
       AUTHENTICATION / USER
    ========================================================================== */

    function getStoredUser() {
        const storedUser =
            localStorage.getItem("school_management_user") ||
            sessionStorage.getItem("school_management_user");

        if (!storedUser) {
            return {};
        }

        try {
            return JSON.parse(storedUser);
        } catch (error) {
            console.error(
                "Unable to read stored user:",
                error
            );

            return {};
        }
    }

    async function apiRequest(endpoint, options = {}) {
        if (typeof window.apiRequest === "function") {
            return window.apiRequest(
                endpoint,
                options
            );
        }

        throw new Error(
            "The central API service is unavailable."
        );
    }

    async function loadCurrentUser() {
        try {
            const response =
                await apiRequest(
                    AUTH_ME_ENDPOINT
                );

            const user =
                response?.user ||
                response?.data?.user ||
                response?.data ||
                response;

            if (
                user &&
                typeof user === "object" &&
                !Array.isArray(user)
            ) {
                currentUser = {
                    ...currentUser,
                    ...user
                };
            }

            populateUserInformation();

            return currentUser;
        } catch (error) {
            console.error(
                "Unable to load current user:",
                error
            );

            return currentUser;
        }
    }

    function populateUserInformation() {
        const userNameElement =
            document.getElementById(
                "userName"
            );

        const userRoleElement =
            document.getElementById(
                "userRole"
            );

        if (userNameElement) {
            const fullName = [
                currentUser.first_name ||
                    currentUser.firstName ||
                    "",
                currentUser.middle_name ||
                    currentUser.middleName ||
                    "",
                currentUser.last_name ||
                    currentUser.lastName ||
                    ""
            ]
                .filter(Boolean)
                .join(" ")
                .trim();

            userNameElement.textContent =
                fullName ||
                currentUser.name ||
                currentUser.username ||
                currentUser.email ||
                "Administrator";
        }

        if (userRoleElement) {
            userRoleElement.textContent =
                currentUser.role_name ||
                currentUser.roleName ||
                currentUser.role ||
                "Administrator";
        }
    }

    /* ==========================================================================
       SETTINGS TABS
    ========================================================================== */

    function setupSettingsTabs() {
        const tabs =
            document.querySelectorAll(
                ".settings-tab"
            );

        const sections =
            document.querySelectorAll(
                ".settings-section"
            );

        tabs.forEach((tab) => {
            tab.onclick = function () {
                const sectionId =
                    tab.dataset.section;

                tabs.forEach((item) => {
                    item.classList.remove(
                        "active"
                    );
                });

                sections.forEach((section) => {
                    section.classList.remove(
                        "active"
                    );
                });

                tab.classList.add(
                    "active"
                );

                const section =
                    document.getElementById(
                        sectionId
                    );

                if (section) {
                    section.classList.add(
                        "active"
                    );
                }
            };
        });
    }

    /* ==========================================================================
       DASHBOARD SIDEBAR
    ========================================================================== */

    function setupSidebar() {
        const sidebar =
            document.getElementById(
                "smsSidebar"
            );

        const sidebarToggle =
            document.getElementById(
                "sidebarToggle"
            );

        const sidebarOverlay =
            document.getElementById(
                "sidebarOverlay"
            );

        function closeSidebar() {
            if (sidebar) {
                sidebar.classList.remove(
                    "show"
                );
            }

            if (sidebarOverlay) {
                sidebarOverlay.classList.remove(
                    "show"
                );
            }
        }

        if (sidebarToggle) {
            sidebarToggle.onclick =
                function () {
                    if (sidebar) {
                        sidebar.classList.toggle(
                            "show"
                        );
                    }

                    if (sidebarOverlay) {
                        sidebarOverlay.classList.toggle(
                            "show"
                        );
                    }
                };
        }

        if (sidebarOverlay) {
            sidebarOverlay.onclick =
                closeSidebar;
        }

        document
            .querySelectorAll(
                ".sidebar-link"
            )
            .forEach((link) => {
                link.onclick =
                    closeSidebar;
            });
    }

    /* ==========================================================================
       SCHOOL SETTINGS
    ========================================================================== */

    function setupSchoolForm() {
        const form =
            document.getElementById(
                "schoolSettingsForm"
            );

        if (!form) {
            return;
        }

        form.onsubmit =
            handleSchoolSubmit;
    }

    function setupResetButton() {
        const button =
            document.getElementById(
                "resetSchoolButton"
            );

        if (!button) {
            return;
        }

        button.onclick =
            resetSchoolForm;
    }

    async function loadSchool() {
        try {
            const schoolId =
                getSchoolId();

            if (schoolId) {
                const response =
                    await apiRequest(
                        `/schools/${encodeURIComponent(
                            schoolId
                        )}`
                    );

                school =
                    extractEntity(
                        response,
                        [
                            "school"
                        ]
                    );

                populateSchoolForm();

                return school;
            }

            const response =
                await apiRequest(
                    SCHOOL_LIST_ENDPOINT
                );

            const schools =
                extractCollection(
                    response,
                    [
                        "schools"
                    ]
                );

            const userSchoolId =
                currentUser.school_id ||
                currentUser.schoolId ||
                null;

            if (userSchoolId) {
                school =
                    schools.find(
                        (item) =>
                            String(item.id) ===
                            String(
                                userSchoolId
                            )
                    ) || {};
            }

            if (!school.id) {
                school =
                    schools[0] || {};
            }

            populateSchoolForm();

            return school;
        } catch (error) {
            console.error(
                "Unable to load school:",
                error
            );

            showMessage(
                error.message ||
                    "Unable to load school information.",
                "danger"
            );

            return {};
        }
    }

    function getSchoolId() {
        return (
            school.id ||
            currentUser.school_id ||
            currentUser.schoolId ||
            null
        );
    }

    function populateSchoolForm() {
        setValue(
            "schoolName",
            school.school_name ||
                school.schoolName
        );

        setValue(
            "schoolCode",
            school.school_code ||
                school.schoolCode
        );

        setValue(
            "registrationNumber",
            school.registration_number ||
                school.registrationNumber
        );

        setValue(
            "schoolEmail",
            school.email ||
                school.school_email
        );

        setValue(
            "schoolPhone",
            school.phone ||
                school.school_phone
        );

        setValue(
            "schoolWebsite",
            school.website
        );

        setValue(
            "schoolType",
            school.school_type ||
                school.schoolType ||
                "Secondary School"
        );

        setValue(
            "schoolState",
            school.state
        );

        setValue(
            "schoolCity",
            school.city
        );

        setValue(
            "schoolAddress",
            school.address
        );

        setValue(
            "schoolCountry",
            school.country ||
                "Nigeria"
        );

        setValue(
            "principalName",
            school.principal_name ||
                school.principalName
        );

        setValue(
            "schoolMotto",
            school.motto ||
                school.school_motto
        );

        setValue(
            "schoolLogoUrl",
            school.logo_url ||
                school.logoUrl
        );
    }

    async function handleSchoolSubmit(event) {
        event.preventDefault();

        const form =
            event.currentTarget;

        if (!form.checkValidity()) {
            form.classList.add(
                "was-validated"
            );

            showMessage(
                "Please complete the required school information.",
                "danger"
            );

            return;
        }

        const data =
            collectSchoolFormData();

        const schoolId =
            getSchoolId();

        setSavingState(true);

        try {
            let response;

            if (schoolId) {
                response =
                    await apiRequest(
                        `/schools/${encodeURIComponent(
                            schoolId
                        )}`,
                        {
                            method: "PUT",
                            body:
                                JSON.stringify(
                                    data
                                )
                        }
                    );
            } else {
                response =
                    await apiRequest(
                        SCHOOL_LIST_ENDPOINT,
                        {
                            method: "POST",
                            body:
                                JSON.stringify(
                                    data
                                )
                        }
                    );
            }

            const returnedSchool =
                extractEntity(
                    response,
                    [
                        "school"
                    ]
                );

            school = {
                ...school,
                ...returnedSchool,
                ...data
            };

            populateSchoolForm();

            showMessage(
                "School information saved successfully.",
                "success"
            );
        } catch (error) {
            console.error(
                "School information save failed:",
                error
            );

            showMessage(
                error.message ||
                    "Unable to save school information.",
                "danger"
            );
        } finally {
            setSavingState(false);
        }
    }

    function collectSchoolFormData() {
        return {
            schoolCode:
                getValue(
                    "schoolCode"
                ).trim(),

            schoolName:
                getValue(
                    "schoolName"
                ).trim(),

            registrationNumber:
                getValue(
                    "registrationNumber"
                ).trim(),

            email:
                getValue(
                    "schoolEmail"
                ).trim(),

            phone:
                getValue(
                    "schoolPhone"
                ).trim(),

            website:
                getValue(
                    "schoolWebsite"
                ).trim(),

            schoolType:
                getValue(
                    "schoolType"
                ).trim(),

            state:
                getValue(
                    "schoolState"
                ).trim(),

            city:
                getValue(
                    "schoolCity"
                ).trim(),

            address:
                getValue(
                    "schoolAddress"
                ).trim(),

            country:
                getValue(
                    "schoolCountry"
                ).trim() ||
                "Nigeria",

            principalName:
                getValue(
                    "principalName"
                ).trim(),

            motto:
                getValue(
                    "schoolMotto"
                ).trim(),

            logoUrl:
                getValue(
                    "schoolLogoUrl"
                ).trim()
        };
    }

    function resetSchoolForm() {
        const confirmed =
            window.confirm(
                "Reset the school information form to the last saved information?"
            );

        if (!confirmed) {
            return;
        }

        populateSchoolForm();

        const form =
            document.getElementById(
                "schoolSettingsForm"
            );

        if (form) {
            form.classList.remove(
                "was-validated"
            );
        }

        showMessage(
            "School information restored.",
            "success"
        );
    }

    function setSavingState(saving) {
        const button =
            document.getElementById(
                "saveSchoolButton"
            );

        if (!button) {
            return;
        }

        if (saving) {
            button.disabled = true;

            button.innerHTML =
                '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Saving...';

            return;
        }

        button.disabled = false;

        button.innerHTML =
            '<i class="bi bi-check-lg me-2"></i>Save Changes';
    }

    /* ==========================================================================
       ACADEMIC SETTINGS
    ========================================================================== */

    async function loadAcademicSettings() {
        try {
            await loadAcademicSessions();
            await loadTerms();

            populateAcademicControls();

            return {
                academicSessions,
                terms,
                currentSession,
                currentTerm
            };
        } catch (error) {
            console.error(
                "Unable to load academic settings:",
                error
            );

            showAcademicMessage(
                error.message ||
                    "Unable to load academic settings.",
                "danger"
            );

            return {
                academicSessions,
                terms,
                currentSession,
                currentTerm
            };
        }
    }

    async function loadAcademicSessions() {
        const response =
            await apiRequest(
                ACADEMIC_SESSIONS_ENDPOINT
            );

        academicSessions =
            extractCollection(
                response,
                [
                    "academicSessions",
                    "sessions"
                ]
            );

        currentSession =
            academicSessions.find(
                (session) =>
                    session.is_current === true ||
                    session.isCurrent === true
            ) || null;

        populateSessionSelect();

        return academicSessions;
    }

    async function loadTerms() {
        const response =
            await apiRequest(
                TERMS_ENDPOINT
            );

        terms =
            extractCollection(
                response,
                [
                    "terms"
                ]
            );

        currentTerm =
            terms.find(
                (term) =>
                    term.is_current === true ||
                    term.isCurrent === true
            ) || null;

        populateTermSelect();

        return terms;
    }

    function populateAcademicControls() {
        populateSessionSelect();
        populateTermSelect();

        updatePassMarkControl();
        updateGradingSystemControl();
    }

    function populateSessionSelect() {
        let element =
            document.getElementById(
                "currentSession"
            );

        if (!element) {
            return;
        }

        if (
            element.tagName.toLowerCase() !==
            "select"
        ) {
            const select =
                document.createElement(
                    "select"
                );

            select.id =
                "currentSessionSelect";

            select.name =
                element.name ||
                "currentSession";

            select.className =
                element.className ||
                "form-select";

            select.required =
                element.required;

            element.replaceWith(
                select
            );

            element = select;
        } else {
            element.id =
                "currentSessionSelect";
        }

        element.innerHTML = "";

        if (!academicSessions.length) {
            const option =
                document.createElement(
                    "option"
                );

            option.value = "";
            option.textContent =
                "No academic sessions available";

            element.appendChild(
                option
            );

            element.disabled = true;

            return;
        }

        academicSessions.forEach(
            (session) => {
                const option =
                    document.createElement(
                        "option"
                    );

                option.value =
                    String(
                        session.id
                    );

                option.textContent =
                    getSessionName(
                        session
                    );

                if (
                    currentSession &&
                    String(
                        currentSession.id
                    ) ===
                        String(
                            session.id
                        )
                ) {
                    option.selected =
                        true;
                }

                element.appendChild(
                    option
                );
            }
        );

        element.disabled = false;

        element.onchange =
            handleSessionChange;
    }

    function populateTermSelect() {
        const select =
            document.getElementById(
                "currentTerm"
            );

        if (!select) {
            return;
        }

        select.innerHTML = "";

        if (!terms.length) {
            const option =
                document.createElement(
                    "option"
                );

            option.value = "";
            option.textContent =
                "No terms available";

            select.appendChild(
                option
            );

            select.disabled = true;

            return;
        }

        terms.forEach(
            (term) => {
                const option =
                    document.createElement(
                        "option"
                    );

                option.value =
                    String(
                        term.id
                    );

                option.textContent =
                    getTermName(
                        term
                    );

                if (
                    currentTerm &&
                    String(
                        currentTerm.id
                    ) ===
                        String(
                            term.id
                        )
                ) {
                    option.selected =
                        true;
                }

                select.appendChild(
                    option
                );
            }
        );

        select.disabled = false;

        select.onchange =
            handleTermChange;
    }

    async function handleSessionChange(event) {
        const sessionId =
            event.target.value;

        if (!sessionId) {
            return;
        }

        const selectedSession =
            academicSessions.find(
                (session) =>
                    String(
                        session.id
                    ) ===
                    String(
                        sessionId
                    )
            );

        if (!selectedSession) {
            return;
        }

        const confirmed =
            window.confirm(
                `Set "${getSessionName(
                    selectedSession
                )}" as the current academic session?`
            );

        if (!confirmed) {
            populateSessionSelect();
            return;
        }

        const select =
            event.target;

        select.disabled = true;

        try {
            const response =
                await apiRequest(
                    `/academic-sessions/${encodeURIComponent(
                        sessionId
                    )}/current`,
                    {
                        method: "PATCH"
                    }
                );

            const returnedSession =
                extractEntity(
                    response,
                    [
                        "academicSession",
                        "session"
                    ]
                );

            academicSessions =
                academicSessions.map(
                    (session) => ({
                        ...session,
                        is_current:
                            String(
                                session.id
                            ) ===
                            String(
                                sessionId
                            ),
                        isCurrent:
                            String(
                                session.id
                            ) ===
                            String(
                                sessionId
                            )
                    })
                );

            currentSession =
                returnedSession?.id
                    ? {
                          ...selectedSession,
                          ...returnedSession,
                          is_current: true,
                          isCurrent: true
                      }
                    : {
                          ...selectedSession,
                          is_current: true,
                          isCurrent: true
                      };

            populateSessionSelect();

            await loadTerms();

            showAcademicMessage(
                "Current academic session updated successfully.",
                "success"
            );
        } catch (error) {
            console.error(
                "Unable to update academic session:",
                error
            );

            populateSessionSelect();

            showAcademicMessage(
                error.message ||
                    "Unable to update the academic session.",
                "danger"
            );
        } finally {
            select.disabled = false;
        }
    }

    async function handleTermChange(event) {
        const termId =
            event.target.value;

        if (!termId) {
            return;
        }

        const selectedTerm =
            terms.find(
                (term) =>
                    String(
                        term.id
                    ) ===
                    String(
                        termId
                    )
            );

        if (!selectedTerm) {
            return;
        }

        const confirmed =
            window.confirm(
                `Set "${getTermName(
                    selectedTerm
                )}" as the current term?`
            );

        if (!confirmed) {
            populateTermSelect();
            return;
        }

        const select =
            event.target;

        select.disabled = true;

        try {
            const response =
                await apiRequest(
                    `/terms/${encodeURIComponent(
                        termId
                    )}`,
                    {
                        method: "PUT",
                        body: JSON.stringify({
                            isCurrent: true
                        })
                    }
                );

            const returnedTerm =
                extractEntity(
                    response,
                    [
                        "term"
                    ]
                );

            terms =
                terms.map(
                    (term) => ({
                        ...term,
                        is_current:
                            String(
                                term.id
                            ) ===
                            String(
                                termId
                            ),
                        isCurrent:
                            String(
                                term.id
                            ) ===
                            String(
                                termId
                            )
                    })
                );

            currentTerm =
                returnedTerm?.id
                    ? {
                          ...selectedTerm,
                          ...returnedTerm,
                          is_current: true,
                          isCurrent: true
                      }
                    : {
                          ...selectedTerm,
                          is_current: true,
                          isCurrent: true
                      };

            populateTermSelect();

            showAcademicMessage(
                "Current term updated successfully.",
                "success"
            );
        } catch (error) {
            console.error(
                "Unable to update current term:",
                error
            );

            populateTermSelect();

            showAcademicMessage(
                error.message ||
                    "Unable to update the current term.",
                "danger"
            );
        } finally {
            select.disabled = false;
        }
    }

    function updatePassMarkControl() {
        const passMark =
            document.getElementById(
                "passMark"
            );

        if (!passMark) {
            return;
        }

        /*
         * The current backend does not yet expose
         * a school-level pass-mark setting.
         *
         * Keep the existing value visible until
         * a dedicated settings endpoint is added.
         */
    }

    function updateGradingSystemControl() {
        const gradingSystem =
            document.getElementById(
                "gradingSystem"
            );

        if (!gradingSystem) {
            return;
        }

        /*
         * The current result-settings backend
         * handles grading bands rather than a
         * global grading-system selector.
         *
         * Therefore this control remains untouched
         * until the corresponding backend setting
         * is implemented.
         */
    }

    function getSessionName(session) {
        return (
            session.session_name ||
            session.sessionName ||
            session.name ||
            "Academic Session"
        );
    }

    function getTermName(term) {
        return (
            term.term_name ||
            term.termName ||
            term.name ||
            "Term"
        );
    }

    function showAcademicMessage(
        message,
        type = "success"
    ) {
        const existing =
            document.getElementById(
                "settingsMessage"
            );

        if (!existing) {
            return;
        }

        existing.className =
            `alert alert-${type}`;

        existing.textContent =
            message;

        existing.classList.remove(
            "d-none"
        );

        window.clearTimeout(
            showAcademicMessage.timeout
        );

        showAcademicMessage.timeout =
            window.setTimeout(
                function () {
                    existing.classList.add(
                        "d-none"
                    );
                },
                5000
            );
    }

    /* ==========================================================================
       NOTIFICATION SETTINGS
    ========================================================================== */

    function setupNotificationSettings() {
        const notificationInputs =
            document.querySelectorAll(
                "#notifications input[type='checkbox']"
            );

        notificationInputs.forEach(
            (input) => {
                input.onchange =
                    function () {
                        showMessage(
                            "Notification settings are not connected to a backend setting yet.",
                            "info"
                        );

                        input.checked =
                            input.defaultChecked;
                    };
            }
        );
    }

    /* ==========================================================================
       SECURITY SETTINGS
    ========================================================================== */

    function setupSecuritySettings() {
        const timeoutInput =
            document.getElementById(
                "timeoutMinutes"
            );

        const strongPassword =
            document.getElementById(
                "requireStrongPassword"
            );

        const sessionTimeout =
            document.getElementById(
                "sessionTimeout"
            );

        if (timeoutInput) {
            timeoutInput.onchange =
                function () {
                    showMessage(
                        "Session timeout is not connected to a backend security setting yet.",
                        "info"
                    );
                };
        }

        if (strongPassword) {
            strongPassword.onchange =
                function () {
                    showMessage(
                        "Strong-password policy is not connected to a backend security setting yet.",
                        "info"
                    );

                    strongPassword.checked =
                        strongPassword.defaultChecked;
                };
        }

        if (sessionTimeout) {
            sessionTimeout.onchange =
                function () {
                    showMessage(
                        "Session timeout policy is not connected to a backend security setting yet.",
                        "info"
                    );

                    sessionTimeout.checked =
                        sessionTimeout.defaultChecked;
                };
        }
    }

    /* ==========================================================================
       LOGOUT
    ========================================================================== */

    function setupLogout() {
        const logoutButton =
            document.getElementById(
                "logoutButton"
            );

        if (!logoutButton) {
            return;
        }

        logoutButton.onclick =
            handleLogout;
    }

    async function handleLogout() {
        const confirmed =
            window.confirm(
                "Are you sure you want to sign out?"
            );

        if (!confirmed) {
            return;
        }

        try {
            if (
                typeof window.apiRequest ===
                "function"
            ) {
                await window.apiRequest(
                    "/auth/logout",
                    {
                        method: "POST"
                    }
                );
            }
        } catch (error) {
            console.error(
                "Logout request failed:",
                error
            );
        } finally {
            if (
                typeof window.clearApiAuthentication ===
                "function"
            ) {
                window.clearApiAuthentication();
            } else {
                localStorage.removeItem(
                    "school_management_token"
                );

                localStorage.removeItem(
                    "school_management_user"
                );

                sessionStorage.removeItem(
                    "school_management_token"
                );

                sessionStorage.removeItem(
                    "school_management_user"
                );
            }

            window.location.href =
                "/pages/login.html";
        }
    }

    /* ==========================================================================
       RESPONSE HELPERS
    ========================================================================== */

    function extractCollection(
        response,
        possibleKeys = []
    ) {
        if (Array.isArray(response)) {
            return response;
        }

        if (
            response &&
            Array.isArray(response.data)
        ) {
            return response.data;
        }

        if (
            response &&
            response.data &&
            typeof response.data ===
                "object"
        ) {
            for (
                const key of possibleKeys
            ) {
                if (
                    Array.isArray(
                        response.data[key]
                    )
                ) {
                    return response.data[
                        key
                    ];
                }
            }
        }

        if (response) {
            for (
                const key of possibleKeys
            ) {
                if (
                    Array.isArray(
                        response[key]
                    )
                ) {
                    return response[key];
                }
            }
        }

        return [];
    }

    function extractEntity(
        response,
        possibleKeys = []
    ) {
        if (
            !response ||
            typeof response !==
                "object"
        ) {
            return {};
        }

        for (
            const key of possibleKeys
        ) {
            if (
                response[key] &&
                typeof response[key] ===
                    "object"
            ) {
                return response[key];
            }
        }

        if (
            response.data &&
            typeof response.data ===
                "object" &&
            !Array.isArray(
                response.data
            )
        ) {
            for (
                const key of possibleKeys
            ) {
                if (
                    response.data[key] &&
                    typeof response.data[
                        key
                    ] === "object"
                ) {
                    return response.data[
                        key
                    ];
                }
            }

            return response.data;
        }

        return response;
    }

    /* ==========================================================================
       FORM HELPERS
    ========================================================================== */

    function setValue(
        id,
        value
    ) {
        const element =
            document.getElementById(
                id
            );

        if (!element) {
            return;
        }

        element.value =
            value === null ||
            value === undefined
                ? ""
                : String(value);
    }

    function getValue(id) {
        const element =
            document.getElementById(
                id
            );

        if (!element) {
            return "";
        }

        return element.value || "";
    }

    /* ==========================================================================
       MESSAGE
    ========================================================================== */

    function showMessage(
        message,
        type = "success"
    ) {
        const element =
            document.getElementById(
                "settingsMessage"
            );

        if (!element) {
            return;
        }

        element.className =
            `alert alert-${type}`;

        element.textContent =
            message;

        element.classList.remove(
            "d-none"
        );

        window.clearTimeout(
            showMessage.timeout
        );

        showMessage.timeout =
            window.setTimeout(
                function () {
                    element.classList.add(
                        "d-none"
                    );
                },
                5000
            );
    }

    /* ==========================================================================
       PUBLIC API
    ========================================================================== */

    window.SettingsPage = {
        initialize,
        loadSchool,
        loadCurrentUser,
        loadAcademicSettings,
        loadAcademicSessions,
        loadTerms,
        populateSchoolForm,
        populateSessionSelect,
        populateTermSelect,
        resetSchoolForm,
        logout: handleLogout
    };

    /* ==========================================================================
       START APPLICATION
    ========================================================================== */

    if (
        document.readyState ===
        "loading"
    ) {
        document.addEventListener(
            "DOMContentLoaded",
            function () {
                setupNotificationSettings();
                setupSecuritySettings();
                initialize();
            },
            {
                once: true
            }
        );
    } else {
        setupNotificationSettings();
        setupSecuritySettings();
        initialize();
    }
})();